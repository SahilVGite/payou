# Pay You frontend. Copy to .env.development for local `npm run dev`.
# Do not include the /api suffix. The client adds it.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8038
API_PROXY_TARGET=http://localhost:8038

# Optional. Used only when media is hosted separately from the API.
# NEXT_PUBLIC_API_IMAGE_URL=http://localhost:8038
